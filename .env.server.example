# Admin API key (Jellyfin Dashboard -> API Keys). Used only by the backend.
# API keys are secrets: never commit them. Prefer a file outside the repo:
# JELLYFIN_API_KEY_FILE=/home/you/.secrets/jellyfin-key
JELLYFIN_API_KEY=your-admin-api-key
# Optional tuning (defaults shown)
# CACHE_TTL_SECONDS=300
# MAX_CACHED_USERS=50
# QUERY_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=200000

# --- Permanent archive ---
# Where the archive database and saved posters live (the Docker image uses /data).
# ARCHIVE_DIR=./data
# How often new plays are copied in, and how often every library is re-read
# (the library pass is what notices deleted items). Minutes.
# PLAY_SYNC_MINUTES=15
# LIBRARY_SYNC_MINUTES=60
# Optional: TMDB key (v3 API key or v4 read access token) for finding posters of
# movies, shows and actors that were deleted before their poster was saved.
# Free at https://www.themoviedb.org/settings/api . TVmaze (shows) and Cover Art
# Archive (music) are used without a key.
# Prefer the "API Read Access Token": it is sent in a header, never in a URL.
# Better still, keep it in a file outside the repo and point at it:
# TMDB_API_KEY_FILE=/home/you/.secrets/tmdb-key
# TMDB_API_KEY=

# --- Hosting without Docker (e.g. Ultra.cc behind its nginx) ---
# Serve everything under a sub-path. Build the frontend with the same value:
#   BASE_PATH=/wrapped/ npm run build
# BASE_PATH=/wrapped/
# Serve the built frontend from this server too (absolute path to dist/).
# STATIC_DIR=/home/you/jellyfin-wrapped/dist
# Jellyfin address as browsers reach it, if different from JELLYFIN_SERVER_URL.
# PUBLIC_JELLYFIN_URL=https://you.host.usbx.me/jellyfin

# --- Hosts that cap virtual memory per process (Ultra.cc: ulimit -v ~9.5 GB) ---
# Without these, Node runs out of address space even with plenty of RAM free.
# LOW_MEMORY=1
# MALLOC_ARENA_MAX=2
# NODE_OPTIONS=--disable-wasm-trap-handler
# MAX_CACHED_USERS=25
