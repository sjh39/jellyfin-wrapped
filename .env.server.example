# Admin API key (Jellyfin Dashboard -> API Keys). Used only by the backend.
JELLYFIN_API_KEY=your-admin-api-key
# Optional tuning (defaults shown)
# CACHE_TTL_SECONDS=300
# MAX_CACHED_USERS=50
# QUERY_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=200000

# --- Permanent archive ---
# Where the archive database and saved posters live (the Docker image uses /data).
# ARCHIVE_DIR=./data
# How often new plays are copied in, and how often every library is re-read
# (the library pass is what notices deleted items). Minutes.
# PLAY_SYNC_MINUTES=15
# LIBRARY_SYNC_MINUTES=60
# Optional: TMDB key (v3 API key or v4 read access token) for finding posters of
# movies, shows and actors that were deleted before their poster was saved.
# Free at https://www.themoviedb.org/settings/api . TVmaze (shows) and Cover Art
# Archive (music) are used without a key.
# TMDB_API_KEY=
